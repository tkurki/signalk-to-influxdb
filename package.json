{
  "name": "signalk-to-influxdb",
  "version": "1.11.0",
  "description": "Signal K server plugin to send all numeric values & positions to InfluxDb 1.x",
  "main": "built/index.js",
  "scripts": {
    "format": "prettier-standard '*.js*'",
    "build": "tsc",
    "test": "npm run build && node --test test/*.test.js",
    "prepublishOnly": "npm run build"
  },
  "repository": "https://github.com/tkurki/signalk-to-influxdb",
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-database",
    "signalk-webapp"
  ],
  "author": "Teppo Kurki <teppo.kurki@iki.fi>",
  "license": "ISC",
  "signalk": {
    "appIcon": "./doc/icon.png",
    "displayName": "Signal K to InfluxDb 1.x"
  },
  "dependencies": {
    "@js-joda/core": "^3.2.0",
    "@js-temporal/polyfill": "^0.5.1",
    "@signalk/server-api": "^2.8.0",
    "@signalk/signalk-schema": "^1.0.3",
    "influx": "^5.0.7"
  },
  "devDependencies": {
    "@types/node": "^18.7.6",
    "express": "^4.17.1",
    "prettier-standard": "^6.0.0",
    "typescript": "^5.9.2"
  }
}
